<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Lote">
  <ItemGroup>
    <Grupo Include="C:\_s418529\logs\build_seguridad_global\20261123-133551-20e904\ronda_1_lote_10_restaurar.proj"><AdditionalProperties>SeguridadGrupo=1</AdditionalProperties></Grupo>
    <Restaurar Include="C:\_s418529\codigo\modulos\contabilidad\Bibliotecas de Contabilidad\Contabilidad\TestMDI_Contabilidad\TestMDI_Contabilidad.csproj"><AdditionalProperties>SolutionDir=C:\_s418529\codigo\modulos\contabilidad\Bibliotecas de Contabilidad\Contabilidad/</AdditionalProperties><Grupo>1</Grupo></Restaurar>
  </ItemGroup>
  <Target Name="Lote">
    <MSBuild Projects="@(Grupo)" Targets="RestaurarGrupo" BuildInParallel="true" ContinueOnError="true" />
  </Target>
  <Target Name="RestaurarGrupo">
    <ItemGroup>
      <DelGrupo Include="@(Restaurar)" Condition="'%(Restaurar.Grupo)' == '$(SeguridadGrupo)'" />
    </ItemGroup>
    <MSBuild Projects="@(DelGrupo)" Targets="Restore" BuildInParallel="false" ContinueOnError="true" Properties="RestorePackagesConfig=true;NuGetAudit=false;MSBuildRestoreSessionId=6db1c70f-7ec5-4d7a-8fc2-4686cea37190" />
