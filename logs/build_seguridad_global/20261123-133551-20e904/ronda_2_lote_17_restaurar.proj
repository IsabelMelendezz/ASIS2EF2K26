<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Lote">
  <ItemGroup>
    <Grupo Include="C:\_s418529\logs\build_seguridad_global\20261123-133551-20e904\ronda_2_lote_17_restaurar.proj"><AdditionalProperties>SeguridadGrupo=1</AdditionalProperties></Grupo>
    <Restaurar Include="C:\_s418529\codigo\modulos\rrhh\Bibliotecas de clase RRHH\Liquidacion_Empleados_Rrhh\TestBajaEmpleado\MSTestLiquidacion.csproj"><AdditionalProperties>SolutionDir=C:\_s418529\codigo\modulos\rrhh\Bibliotecas de clase RRHH\Liquidacion_Empleados_Rrhh/</AdditionalProperties><Grupo>1</Grupo></Restaurar>
  </ItemGroup>
  <Target Name="Lote">
    <MSBuild Projects="@(Grupo)" Targets="RestaurarGrupo" BuildInParallel="true" ContinueOnError="true" />
  </Target>
  <Target Name="RestaurarGrupo">
    <ItemGroup>
      <DelGrupo Include="@(Restaurar)" Condition="'%(Restaurar.Grupo)' == '$(SeguridadGrupo)'" />
    </ItemGroup>
    <MSBuild Projects="@(DelGrupo)" Targets="Restore" BuildInParallel="false" ContinueOnError="true" Properties="RestorePackagesConfig=true;NuGetAudit=false;MSBuildRestoreSessionId=305ce671-f582-4ba3-b023-e27ae49573bf" />
  </Target>
</Project>
